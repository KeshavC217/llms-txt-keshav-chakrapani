# --- The AI sieve (optional; without it the file has no summary and no notes) ---
# Get a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Two roles. The guide makes one judgment about the whole site, so consistency
# matters more than price; the worker annotates every chunk of links, so its
# cost and its slow tail both multiply. Defaults are the measured winners -
# see the table in lib/ai/models.ts, or re-run `npm run bench`.
# AI_GUIDE_MODEL=gemini-3.5-flash-lite
# AI_WORKER_MODEL=gemma-4-31b-it

# --- Supabase (required for storage, and therefore for automated updates) ---
# Apply db/schema.sql in the SQL editor before the first run.
# Project settings -> Data API -> Project URL
SUPABASE_URL=
# Project settings -> API Keys -> Secret key (sb_secret_...). SERVER ONLY,
# never NEXT_PUBLIC_. This is the current-generation key; the legacy
# service_role JWT also works and is accepted here, but Supabase is
# deprecating it by the end of 2026. Both carry BYPASSRLS, which is what this
# needs — our tables have RLS on with no policies, so nothing else can read
# them. Secret keys additionally refuse to work from a browser (HTTP 401),
# which is a useful backstop against leaking one into client code.
#
SUPABASE_SECRET_KEY=

# --- Supabase auth (required to generate at all; reading saved files is open) ---
# Project settings -> API Keys -> Publishable key (sb_publishable_...)
#
# The anonymous tier, so row-level security applies to what a signed-in user
# does. It is used server-side only - sign-in runs in a server action - so it
# needs no NEXT_PUBLIC_ prefix even though the key would be safe to expose.
# Reuses SUPABASE_URL above.
SUPABASE_PUBLISHABLE_KEY=

# --- Monitoring ---
# How closely a single site is watched. The interval halves when a site changes
# and grows by half when it has not, between these bounds. An hour is
# affordable because most checks cost one request: the sitemap usually settles
# the question and only a moved site is crawled.
# MONITOR_MIN_INTERVAL_HOURS=1
# MONITOR_MAX_INTERVAL_HOURS=168
#
# What one run of /api/refresh may spend. Two budgets rather than one "sites per
# run", because a sitemap check costs half a second and a regeneration costs
# thirty: a single number is too cautious for the first and reckless for the
# second.
# MONITOR_CHECKS_PER_RUN=40
# MONITOR_REGENERATIONS_PER_RUN=2
# Sites are independent - different hosts, no shared state - so they are checked
# several at a time. Per-host politeness is unaffected; the pacer still governs
# the requests within one crawl.
# MONITOR_CONCURRENCY=4

# --- Waking the worker ---
# Crawling happens in a GitHub Actions run (.github/workflows/worker.yml).
# Asking for a site sends a repository_dispatch so the run starts within
# seconds rather than waiting for the schedule.
#
# A fine-grained token with Contents: read-write on this repository only, or a
# classic token with `repo`. Without it the app still works: a queued row is
# collected by the next scheduled pass instead of immediately.
GITHUB_DISPATCH_TOKEN=
# owner/repo, e.g. KeshavC217/llms-txt-keshav-chakrapani
GITHUB_REPOSITORY=

# The worker itself needs SUPABASE_URL, SUPABASE_SECRET_KEY and
# OPENROUTER_API_KEY as *repository* secrets, since it runs in the runner
# rather than on the deployment.

# --- Crawl tuning (optional, defaults shown) ---
# One ceiling for every crawl. An effort level was tried and dropped: it made
# the same URL produce different files, so the stored answer depended on which
# effort asked first.
# CRAWL_MAX_PAGES=50
# CRAWL_CONCURRENCY=4
#
# How long one site may go on for before we conclude it is pathological and
# move to the next. It used to be twenty-five seconds because a crawl had to
# finish inside a request; nothing waits on a crawl now.
# CRAWL_TIME_BUDGET_MS=600000

# A stop on one worker pass. The runner allows six hours; anything left is
# still queued for the next pass.
# WORKER_RUN_LIMIT_MS=5400000
# Minimum gap between requests to one host. Bounded concurrency alone is not
# politeness: 8 workers against one host is 8 simultaneous requests sustained
# for the whole crawl. Widens automatically on 429/503 and never narrows
# mid-crawl.
# CRAWL_MIN_REQUEST_INTERVAL_MS=120
# CRAWL_MAX_REQUEST_INTERVAL_MS=2000

# --- Local testing against a local server (optional) ---
# The SSRF guard refuses any URL resolving to a loopback, link-local, private or
# CGNAT address, and re-checks after redirects. Set this to 1 to crawl a server
# running on your own machine. Never set it in a deployment: the endpoint fetches
# a URL the caller supplies, so without the guard the app is an open proxy into
# whatever the function can reach - cloud instance metadata included.
# ALLOW_PRIVATE_CRAWL_TARGETS=1

# --- Live testing (optional) ---
# An account on the Supabase project above, used by `npm run integration` to
# exercise the gated generate path against real models. Left empty here on
# purpose: these are
# working credentials, so they belong in .env, which is ignored, and never in
# the repository.
TEST_ACCOUNT_EMAIL=
TEST_ACCOUNT_PASSWORD=
