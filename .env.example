# --- The AI sieve (optional; the generator works fully without it) ---
# Get a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Two roles. The guide makes one judgment about the whole site, so consistency
# matters more than price; the worker annotates every chunk of links, so its
# cost and its slow tail both multiply. Defaults are the measured winners -
# see the table in lib/ai/models.ts, or re-run `npm run bench`.
# AI_GUIDE_MODEL=gemini-3.5-flash-lite
# AI_WORKER_MODEL=gemma-4-31b-it

# --- Supabase (required for monitoring / automated updates) ---
# Project settings -> Data API -> Project URL
SUPABASE_URL=
# Project settings -> API Keys -> Secret key (sb_secret_...). SERVER ONLY,
# never NEXT_PUBLIC_. This is the current-generation key; the legacy
# service_role JWT also works and is accepted here, but Supabase is
# deprecating it by the end of 2026. Both carry BYPASSRLS, which is what this
# needs — our tables have RLS on with no policies, so nothing else can read
# them. Secret keys additionally refuse to work from a browser (HTTP 401),
# which is a useful backstop against leaking one into client code.
#
SUPABASE_SECRET_KEY=

# --- Supabase auth (required for the LLM features; the generator works without) ---
# Project settings -> API Keys -> Publishable key (sb_publishable_...)
#
# The anonymous tier, so row-level security applies to what a signed-in user
# does. It is used server-side only - sign-in runs in a server action - so it
# needs no NEXT_PUBLIC_ prefix even though the key would be safe to expose.
# Reuses SUPABASE_URL above.
SUPABASE_PUBLISHABLE_KEY=

# --- Monitoring cron ---
# Shared secret required by POST /api/refresh. Generate with:
#   openssl rand -hex 32
CRON_SECRET=

# --- Crawl tuning (optional, defaults shown) ---
# MAX_CRAWL_PAGES=100
# MAX_CRAWL_CONCURRENCY=8
# MAX_CRAWL_RENDERS=30
# Minimum gap between requests to one host. Bounded concurrency alone is not
# politeness: 8 workers against one host is 8 simultaneous requests sustained
# for the whole crawl. Widens automatically on 429/503 and never narrows
# mid-crawl.
# CRAWL_MIN_REQUEST_INTERVAL_MS=120
# CRAWL_MAX_REQUEST_INTERVAL_MS=2000

# --- Rendering pages a fetch cannot read (optional) ---
# A browser behind an HTTP endpoint: Browserless, Browserbase, or anything with
# the same shape (POST {url} -> HTML). Chromium is not bundled: it does not fit
# comfortably in a Vercel function, and a browser is needed on a small fraction
# of requests. Unset, rendering is skipped and everything else still works.
# RENDER_ENDPOINT=https://production-sfo.browserless.io/content?token=...
# RENDER_TOKEN=

# --- Live testing (optional) ---
# An account on the Supabase project above, used to exercise the gated
# /api/enhance path against real models. Left empty here on purpose: these are
# working credentials, so they belong in .env, which is ignored, and never in
# the repository.
TEST_ACCOUNT_EMAIL=
TEST_ACCOUNT_PASSWORD=
